  storyText: "\uC544, \uADF8\uAC74 \uC544\uB2D9\uB2C8\uB2E4. {w}\uBC14\uC774\uB7EC\uC2A4\uC5D0
    \uAC10\uC5FC\uC740 \uB418\uC5C8\uC9C0\uB9CC \uCD08\uAE30 \uB2E8\uACC4\uB77C \uC0C1\uB2F4\uB9CC
