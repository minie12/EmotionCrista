  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 83
  indentLevel: 0
  storyText: "\uC9C1\uC811\uC801\uC73C\uB85C \uBB3C\uB9AC\uB294 \uAC8C \uC544\uB2C8\uBA74
    \uAC10\uC5FC\uB418\uC9C0\uB294 \uC54A\uC9C0\uB9CC \uC720\uC77C\uD558\uAC8C \uC5B5\uC81C
    \uC2DC\uD0AC \uBC29\uBC95\uC740 \uAC10\uC815\uC801\uC73C\uB85C \uB0B4\uBAB0\uB9B0
    \uB9D0\uC744 \uB4E4\uC5B4\uC8FC\uB294 \uAC81\uB2C8\uB2E4.\r{wc}\uBC14\uC774\uB7EC\uC2A4\uC5D0
    \uAC78\uB9AC\uBA74 \uC778\uAC04\uC758 \uD2B9\uC815\uD55C \uD55C \uAC10\uC815\uB9CC\uC744
    \uACE0\uC870\uC2DC\uCF1C \uAC10\uC5FC\uC778\uC5D0\uAC90 \uADF8 \uAC10\uC815\uB9CC
    \uB0A8\uC2B5\uB2C8\uB2E4. \uC544\uBB34\uC5D0\uAC8C\uB77C\uB3C4 \uD638\uC18C\uD558\uACE0
    \uC2F6\uC5B4 \uD558\uAE30 \uB54C\uBB38\uC5D0 \uADF8\uB4E4\uC758 \uB9D0\uC744
    \uB4E4\uC5B4\uC8FC\uB294 \uC0C1\uB2F4\uC0AC\uC758 \uC5ED\uD560\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
