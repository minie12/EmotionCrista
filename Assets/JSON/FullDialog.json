[{"id":"Dialogue.Tutorial.0001","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"오셨습니까? {wc}제가 앞으로 당신을 교육 할 담당 사수입니다. {wc}이름이...?","desc":"프롤로그 #1 출근"},{"id":"Dialogue.Tutorial.0002","character":"Player","spriteName":null,"spritePosition":null,"dialog":"{w=0.4}아… 안녕하십니까. {$PlayerName}입니다. 잘 부탁드립니다.","desc":"플레이어 이름 입력 이후"},{"id":"Dialogue.Tutorial.0003","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"좋습니다. {$PlayerName}, 오늘부터 바로 상담사로 일을 시작할 것입니다. {wc}앞으로 사용하게 될 제련 시스템에 대해 설명해드리겠습니다.{wc}요즘 좀비 바이러스가 퍼지고 있는건 알고 계실테고… ","desc":null},{"id":"Dialogue.Tutorial.0004","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"직접적으로 물리는 게 아니면 감염되지는 않지만 유일하게 억제 시킬 방법은 감정적으로 내몰린 말을 들어주는 겁니다. {wc}바이러스에 걸리면 인간의 특정한 한 감정만을 고조시켜 감염인에겐 그 감정만 남습니다. 아무에게라도 호소하고 싶어 하기 때문에 그들의 말을 들어주는 상담사의 역할이 필요합니다.","desc":null},{"id":"Dialogue.Tutorial.0005","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"그리고 내담자들의 감정이 극대화되었을 땐 당신은 그들의 감정을 해소해주기 위한 제련을 하시게 될 겁니다.{wc}우리는 그걸 제련 시스템이라 부르고 있습니다. {wc}여기까지 이해되셨습니까?","desc":null},{"id":"Dialogue.Tutorial.0006","character":"Player","spriteName":null,"spritePosition":null,"dialog":"네... 그럼 지금 보러 가는 사람들은 좀비인가요?","desc":null},{"id":"Dialogue.Tutorial.0007","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"아, 그건 아닙니다. 바이러스에 감염은 되었지만 초기 단계라 상담만 잘 해준다면 감염될 위험은 적습니다.","desc":null},{"id":"Dialogue.Tutorial.0008","character":"Player","spriteName":null,"spritePosition":null,"dialog":"하지만... 위험한거 아닌가요?","desc":null},{"id":"Dialogue.Tutorial.0009","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"... 듣지 못하셨군요. {wc}당신은 유달리 뛰어난 탓에 뽑힌 것이 아니라 순전히 특이 체질 덕분인 겁니다.","desc":null},{"id":"Dialogue.Tutorial.0010","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"감정 바이러스에 꽤 면역력이 있기 때문에 이 자리에 있게 된 것입니다.","desc":null},{"id":"Dialogue.Tutorial.0011","character":"Player","spriteName":null,"spritePosition":null,"dialog":"아하...","desc":null},{"id":"Dialogue.Tutorial.0012","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"추가로 말하자면 당신은 연구 대상이기도 합니다. {wc}그러니 내담자와의 상담 이후 매일 추가로 제 연구실에서 검진받고 건강 상태를 체크 받으셔야 합니다.","desc":null},{"id":"Dialogue.Tutorial.0013","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"그럼 가장 위험부담이 적은 내담자부터 상담하겠습니다.","desc":null},{"id":"Dialogue.Tutorial.0014","character":"Player","spriteName":null,"spritePosition":null,"dialog":"... 위험... 이요...","desc":null},{"id":"Dialogue.Tutorial.0015","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"노란색으로 분류되는 감정들은 다른 감정들과 달리 감정이 격화되어도 바로 좀비로 변하지는 않습니다.","desc":null},{"id":"Dialogue.Tutorial.0016","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"상담을 들어줄 시간이 많으니 좀 덜 부담스러울 겁니다. 여길 보겠습니다.","desc":null},{"id":"Dialogue.Tutorial.0017","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"우측 하단의 점수 게이지를 보면 제련해야 할 광물의 색을 알 수 있습니다. ","desc":"미니게임 설명 시작"},{"id":"Dialogue.Tutorial.0018","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"지금은 노란색이니, 노란 광물을 제련하시면 됩니다. {wc}목표 광물을 제련하면 점수 게이지가 올라가고, 그 외 광물을 제련하면 피버 게이지가 찹니다. {wc}오른쪽 상단에는 제련하기 위해 갖춰야 할 광물의 형태입니다.","desc":null},{"id":"Dialogue.Tutorial.0019","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"색칠된 부분을 클릭하면 광물이 제련될 것입니다. {wc}광물을 이동시키기 위해서는 A와 D를 이용하면 됩니다. {wc}이 광물을 클릭해보세요.","desc":null},{"id":"Dialogue.Tutorial.0020","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"A 또는 D를 눌렀을 때, 해당 광물들이 반시계 방향 또는 시계 방향으로 회전 할 것입니다.","desc":null},{"id":"Dialogue.Tutorial.0021","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"그럼 이제 광물을 제련해봅시다. {wc} 이 광물을 클릭해보세요.","desc":null},{"id":"Dialogue.Tutorial.0022","character":"Patrick","spriteName":null,"spritePosition":null,"dialog":"잘하셨습니다. 상담은 이렇게 진행하시면 됩니다.","desc":null},{"id":"Dialogue.Tutorial.0023","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"이제 직접 들어가서 내담자분과 상담하시면 될 것 같습니다. ","desc":"복도로 복귀"},{"id":"Dialogue.Tutorial.0024","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"끝나면 제 연구실로 오십시오.","desc":null},{"id":"Dialogue.naria.0001","character":"Naria","spriteName":"Naria_Talking","spritePosition":"Center","dialog":"어머, 안녕하세요! 저는 나리아예요. 잘 부탁드릴게요!","desc":null},{"id":"Dialogue.naria.0002","character":"Player","spriteName":null,"spritePosition":null,"dialog":"네, 상담을 맡은 {$PlayerName} 입니다. 저도 잘 부탁드려요. {wc}그래서... 요즘 잘 지내시나요?","desc":null},{"id":"Dialogue.naria.0003","character":"Naria","spriteName":"Naria_Basic","spritePosition":"Center","dialog":"네에, 잘 지내고 있어요. ","desc":null},{"id":"Dialogue.naria.0004","character":"Naria","spriteName":"Naria_Happy","spritePosition":"Center","dialog":"최근에 받은 월급으로 <두근두근 탈출 좀비랜드>의 주인공 피규어를 샀거든요! {wc}거기다 회사에 공헌할 기회를 얻어서 더 행복하네요!","desc":null},{"id":"Dialogue.naria.0005","character":"Player","spriteName":null,"spritePosition":null,"dialog":"{i}‘공헌...?’{\/i} {wc}평소 갖고 싶어하시던 건가요?","desc":null},{"id":"Dialogue.naria.0006","character":"Naria","spriteName":"Naria_Talking","spritePosition":"Center","dialog":"네네! 제가 정말 좋아하는 만화거든요!","desc":null},{"id":"Dialogue.naria.0007","character":"Naria","spriteName":"Naria_Basic","spritePosition":"Center","dialog":"좀비가 있는 세상에 갑자기 떨어진 주인공이 살아가는 이야기예요.","desc":null},{"id":"Dialogue.naria.0008","character":"Player","spriteName":null,"spritePosition":null,"dialog":"원랜 좀비가 없던 세계에 살던 친구인가요?","desc":null},{"id":"Dialogue.naria.0009","character":"Naria","spriteName":"Naria_Basic","spritePosition":"Center","dialog":"맞아요. 그래서 처음엔 바보같이 대처하기도 했지만, 잘 버텨서 완결까지도 결국 완벽했어요.","desc":null},{"id":"Dialogue.naria.0010","character":"Naria","spriteName":"Naria_Crazy","spritePosition":"Center","dialog":"아니 글쎄, 주인공이 좀비를 위협해보는데 좀비가 그런 게 통하겠냐구요, 하하하. {punch=10,0.5}","desc":null},{"id":"Dialogue.naria.0011","character":"Naria","spriteName":"Naria_Happy","spritePosition":"Center","dialog":"작가님이 완전 존경스럽다니까요! 다음 차기작이 정말 기대돼요.","desc":null},{"id":"Dialogue.naria.0012","character":"Player","spriteName":null,"spritePosition":null,"dialog":"아... 그 작가분의 차기작 얘기도 나왔나요?","desc":null},{"id":"Dialogue.naria.0013","character":"Naria","spriteName":"Naria_Tired1","spritePosition":"Center","dialog":"{s=10}...{\/s}","desc":null},{"id":"Dialogue.naria.0014","character":"Naria","spriteName":"Naria_Basic ","spritePosition":"Center","dialog":"네에.","desc":null},{"id":"Dialogue.naria.0015","character":"Player","spriteName":null,"spritePosition":null,"dialog":"정말 기대 되시겠어요.","desc":null},{"id":"Dialogue.naria.0016","character":"Naria","spriteName":"Naria_Basic ","spritePosition":"Center","dialog":"네네. 전작과 이어지는 세계관이라지 뭐예요!","desc":null},{"id":"Dialogue.naria.0017","character":"Naria","spriteName":"Naria_Smile","spritePosition":"Center","dialog":"기다리는 게 제 삶의 낙 중 하나예요.","desc":null},{"id":"Dialogue.naria.0018","character":"Player","spriteName":null,"spritePosition":null,"dialog":"언제쯤 나오는지 아시나요?","desc":null},{"id":"Dialogue.naria.0019","character":"Naria","spriteName":"Naria_Talking","spritePosition":"Center","dialog":"언제쯤이요? {wc}{s=10}...{\/s}","desc":null},{"id":"Dialogue.naria.0020","character":"Naria","spriteName":"Naria_Tired2","spritePosition":"Center","dialog":"{s=10}...{\/s}","desc":null},{"id":"Dialogue.naria.0021","character":"Naria","spriteName":"Naria_Tired1","spritePosition":"Center","dialog":"{s=15}...{\/s}","desc":null},{"id":"Dialogue.naria.0022","character":"Naria","spriteName":"Naria_Smile","spritePosition":"Center","dialog":"그러게요!","desc":null},{"id":"Dialogue.naria.0023","character":"Player","spriteName":null,"spritePosition":null,"dialog":"아직 소식이 없는거군요.","desc":null},{"id":"Dialogue.naria.0024","character":"Naria","spriteName":"Naria_Happy","spritePosition":"Center","dialog":"맞아요, 어서 빨리 소식이 나오면 좋겠어요! {wc}어떻게 전작과 이어질 지 너무 궁금해요!","desc":null},{"id":"Dialogue.naria.0025","character":"Naria","spriteName":"Naria_Smile","spritePosition":"Center","dialog":"전작의 주인공이 다음 시리즈에도 좀 얼굴 비춰 주면 좋을 거 같아요. 좀 더 성장한 모습이겠죠?","desc":null},{"id":"Dialogue.naria.0026","character":"Player","spriteName":null,"spritePosition":null,"dialog":"‘내담자분의 감정이 고조되었다. 제련하자.’","desc":null},{"id":"Dialogue.naria.0027","character":"Player","spriteName":null,"spritePosition":null,"dialog":"혹시…무슨 문제가 있나요?","desc":null},{"id":"Dialogue.naria.0028","character":"Naria","spriteName":"Naria_Basic","spritePosition":"Center","dialog":"{s=10}...{\/s}","desc":null},{"id":"Dialogue.naria.0029","character":"Naria","spriteName":"Naria_Talking","spritePosition":"Center","dialog":"무슨 문제요?","desc":null},{"id":"Dialogue.naria.0030","character":"Naria","spriteName":"Naria_Happy","spritePosition":"Center","dialog":"아니요! 아무런 문제도 없어요! 하하! {wc}왜 그렇게 생각하시는 거죠?","desc":null},{"id":"Dialogue.naria.0031","character":"Player","spriteName":null,"spritePosition":null,"dialog":"네? 그야... {wc}’감정 광물의 색이 바뀌는게 이상한데 섣불리 말을 꺼내기엔…’","desc":null},{"id":"Dialogue.naria.0032","character":"Naria","spriteName":"Naria_Crazy","spritePosition":"Center","dialog":"{wp=2}하하. 없어요. 없다니까요?","desc":null},{"id":"Dialogue.naria.0033","character":"Naria","spriteName":"Naria_Crazy","spritePosition":"Center","dialog":"{size=70}비록 작업실에 좀비가 습격했을때도 작업은 계속해서 완결도 내셨고...!{\/size}{punch=10,0.5}","desc":null},{"id":"Dialogue.naria.0034","character":"Naria","spriteName":"Naria_Happy","spritePosition":"Center","dialog":"차기작 소식도 나왔었으니까 아무 문제 없으시다구요...","desc":null},{"id":"Dialogue.naria.0035","character":"Player","spriteName":null,"spritePosition":null,"dialog":"그... 그렇군요. 멋진 분이시네요.","desc":null},{"id":"Dialogue.naria.0036","character":"Naria","spriteName":"Naria_Tired2","spritePosition":"Center","dialog":"... 제가 너무 열 올렸죠... 만화 얘기만 나오면 이러더라구요. 하하...","desc":null},{"id":"Dialogue.naria.0037","character":"Player","spriteName":null,"spritePosition":null,"dialog":"더 하고 싶으신 말이 있나요?","desc":null},{"id":"Dialogue.naria.0038","character":"Naria","spriteName":"Naria_Tired1","spritePosition":"Center","dialog":"... 아니요.","desc":null},{"id":"Dialogue.naria.0039","character":"Naria","spriteName":"Naria_Tired2","spritePosition":"Center","dialog":"다 잘 들어주셔서 만족스럽네요! {wc}회사에 도움이 될 수 있어서 더 기쁘구요.","desc":null},{"id":"Dialogue.naria.0040","character":"Naria","spriteName":"Naria_Smile","spritePosition":"Center","dialog":"선생님, 다음에 올 땐 만화책 가져올테니 한 번 봐보실래요?","desc":null},{"id":"Dialogue.naria.0041","character":"Player","spriteName":null,"spritePosition":null,"dialog":"좋아요, 그럼 다음에 봐요.","desc":null},{"id":"Dialogue.naria.0042","character":"Player","spriteName":null,"spritePosition":null,"dialog":"생각보다 힘들었다… {wc}...! 사수님...!","desc":null},{"id":"Dialogue.naria.0043","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"고생하셨습니다. (그가 내 어깨를 툭툭 쳐주었다.)","desc":null},{"id":"Dialogue.naria.0044","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"이제 제 연구실로 잠시 따라오십시오.","desc":null},{"id":"Dialogue.naria.0045","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"여긴 제 연구실입니다. {wc}매일 퇴근하시기 전에 혹여 감염 증상이 있을지 모르니, 간단한 설문 조사 및 검사를 하시게 되실 겁니다. {wc}그 데이터를 기반으로 당신에게 필요한 조치를 해 드릴 수 있으니, 성실히 응해 주시길 바랍니다.","desc":null},{"id":"Dialogue.naria.0046","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"저는 대부분 이 연구실에 있으니 상담을 마치신 뒤 찾아오시면 됩니다.","desc":null},{"id":"Dialogue.naria.0047","character":"Player","spriteName":null,"spritePosition":null,"dialog":"알겠습니다.","desc":null},{"id":"Dialogue.naria.0048","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"우선 드린 패드에 있는 설문지 작성을 하고 오신 뒤 생체 스캔으로 마무리할테니 작성하고 오시길 바랍니다.","desc":null},{"id":"Dialogue.naria.0049","character":"Player","spriteName":null,"spritePosition":null,"dialog":"패드요?","desc":null},{"id":"Dialogue.naria.0050","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"네. 패드를 열어보시면 아실겁니다.","desc":null},{"id":"Dialogue.naria.0051","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"완료하셨습니까?","desc":null},{"id":"Dialogue.naria.0052","character":"Player","spriteName":null,"spritePosition":null,"dialog":"아, 네.","desc":null},{"id":"Dialogue.naria.0053","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"제출하신 서류는 검토해볼테니, 이리오셔서 스캔 받으신 후 귀가하시면 됩니다. {wc}여기 앉으십시오.","desc":null},{"id":"Dialogue.naria.0054","character":"Player","spriteName":null,"spritePosition":null,"dialog":"‘자리로 가서 서자 빛이 나며 머리부터 발 끝까지 스캔하였다.’ {flash=0.5}","desc":null},{"id":"Dialogue.naria.0055","character":"Player","spriteName":null,"spritePosition":null,"dialog":"저, 근데 사수님…","desc":null},{"id":"Dialogue.naria.0056","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"네, 말씀하십시오.","desc":null},{"id":"Dialogue.naria.0057","character":"Player","spriteName":null,"spritePosition":null,"dialog":"설문 내용은 내담자분들이 주로 겪는 증상들인가요?","desc":null},{"id":"Dialogue.naria.0058","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"통계적으론 그렇습니다.","desc":null},{"id":"Dialogue.naria.0059","character":"Player","spriteName":null,"spritePosition":null,"dialog":"…","desc":null},{"id":"Dialogue.naria.0060","character":"Patrick","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"결과는 이상이 있을 시에 바로 알려드리겠습니다. {wc}다음은 따라오시면 됩니다.","desc":null},{"id":"Dialogue.naria.0061","character":"Patrick","spriteName":"Patrick_Talking, Raz_Basic","spritePosition":"Left, Right","dialog":"{$PlayerName}, 이쪽은 라즈 연구원이십니다.","desc":null},{"id":"Dialogue.naria.0062","character":"Raz","spriteName":"Patrick_Basic, Raz_Talking","spritePosition":"Left, Right","dialog":"안녕하세요! 라즈입니다.","desc":null},{"id":"Dialogue.naria.0063","character":"Raz","spriteName":"Patrick_Basic, Raz_Smile","spritePosition":"Left, Right","dialog":"앞으로 잘 부탁드릴게요.","desc":null},{"id":"Dialogue.naria.0064","character":"Player","spriteName":null,"spritePosition":null,"dialog":"아, 안녕하세요.","desc":null},{"id":"Dialogue.naria.0065","character":"Raz","spriteName":"Patrick_Basic, Raz_Basic","spritePosition":"Left, Right","dialog":"저는 상담사가 아닌 연구원이기 때문에 내담자들과 직접 마주하지 않지만, 그들에 관한 정보를 모아야 해요. {wc}그래서 앞으로 {$PlayerName} 선생님께 내담자들에 대한 일일보고를 부탁드리려 해요!","desc":null},{"id":"Dialogue.naria.0066","character":"Raz","spriteName":"Patrick_Basic, Raz_Smile","spritePosition":"Left, Right","dialog":"매 상담이 끝나면 여기, 패트릭님의 연구실로 와서 제게 말을 걸어주시면 된답니다.","desc":null},{"id":"Dialogue.naria.0067","character":"Raz","spriteName":"Patrick_Basic, Raz_Talking","spritePosition":"Left, Right","dialog":"오늘의 내담자분은 어떠셨나요?","desc":null},{"id":"Dialogue.naria.0068","character":"Player","spriteName":null,"spritePosition":null,"dialog":"오늘 내담자분은 굉장히 밝으셨어요. 그리고 상담을 공헌이라고 칭하시던데…","desc":null},{"id":"Dialogue.naria.0069","character":"Raz","spriteName":"Patrick_Basic, Raz_Basic","spritePosition":"Left, Right","dialog":"아, 행복한 감정 내담자분들의 특징이죠. 회사에 도움이 되는 걸 뿌듯해 하세요.","desc":null},{"id":"Dialogue.naria.0070","character":"Raz","spriteName":"Patrick_Basic, Raz_Smile","spritePosition":"Left, Right","dialog":"내담자분들의 특징은 메뉴얼을 살펴보시면 있어요! 잘 확인해보시면 도움이 될 거예요.","desc":null},{"id":"Dialogue.naria.0071","character":"Patrick","spriteName":"Patrick_Talking, Raz_Basic","spritePosition":"Left, Right","dialog":"들으신대로... 앞으로 상담이 끝나면 저에게도 보고하셔야 하니 여기로 오시면 됩니다.","desc":null},{"id":"Dialogue.naria.0072","character":"Player","spriteName":null,"spritePosition":null,"dialog":"알겠습니다.","desc":null},{"id":"Dialogue.naria.0073","character":"Raz","spriteName":"Raz_Basic","spritePosition":"Center","dialog":"저는 이만 오늘 말씀해주신 걸 작성하러 가야겠어요.","desc":null},{"id":"Dialogue.naria.0074","character":"Raz","spriteName":"Raz_Smile","spritePosition":"Center","dialog":"오늘 하루도 고생하셨어요!","desc":null},{"id":"Dialogue.naria.0075","character":"Player","spriteName":null,"spritePosition":null,"dialog":"(굉장히 밝은 사람이다. 저분의 감정은 밝게 빛나는 것 같아서 한 번쯤 제련해보고 싶단 생각이 들었다.)","desc":null},{"id":"Dialogue.naria.0076","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"수고하셨습니다. 이만 가보시죠.","desc":null},{"id":"Dialogue.naria.0077","character":"Player","spriteName":null,"spritePosition":null,"dialog":"아, 네 고생하셨습니다.","desc":null},{"id":"Dialogue.naria.0078","character":"Player","spriteName":null,"spritePosition":null,"dialog":"출근하기 전에도 느꼈지만, 왠지 모르게 익숙한 방이다.","desc":null},{"id":"Dialogue.naria.0079","character":"Player","spriteName":null,"spritePosition":null,"dialog":"크리스타가 모든 쉘터 내의 건축물들도 설계했으니 당연한 얘기겠지만…","desc":null},{"id":"Dialogue.Lulian.0001","character":"Player","spriteName":"Lulian_Sad1","spritePosition":"Center","dialog":"(아이가 울고 있다.)","desc":"배경\/상담실 복도"},{"id":"Dialogue.Lulian.0002","character":"Player","spriteName":"Lulian_Sad2","spritePosition":"Center","dialog":"(...나를 봐주지도 않고 울고 있다.) ","desc":null},{"id":"Dialogue.Lulian.0003","character":"Player","spriteName":"Lulian_Crying","spritePosition":"Center","dialog":"(점점 더 큰 소리로 울기 시작하자 다른 상담사들이 양해를 구하며 아이를 상담실로 데리고 들어간다.)","desc":null},{"id":"Dialogue.Lulian.0004","character":"Player","spriteName":"Patrick_Basic, Raz_Basic","spritePosition":"Left, Right","dialog":"(그때 복도에 사수님과 연구원님이 눈에 들어왔다.)","desc":null},{"id":"Dialogue.Lulian.0005","character":"Patrick","spriteName":"Patrick_Talking, Raz_Basic","spritePosition":"Left, Right","dialog":"무슨 일이십니까?","desc":null},{"id":"Dialogue.Lulian.0006","character":"Raz","spriteName":"Patrick_Basic, Raz_Talking","spritePosition":"Left, Right","dialog":"그러게 말이에요, 얼굴색이 안 좋으세요.","desc":null},{"id":"Dialogue.Lulian.0007","character":"Player","spriteName":null,"spritePosition":null,"dialog":"그, 게... {wc}(자초지종 설명했다.)","desc":null},{"id":"Dialogue.Lulian.0008","character":"Patrick","spriteName":"Patrick_Talking, Raz_Basic","spritePosition":"Left, Right","dialog":"그랬군요. 내담자분의 나이가 어리시니 그 눈높이에 맞춰 방법을 찾아보셔야겠습니다.","desc":null},{"id":"Dialogue.Lulian.0009","character":"Raz","spriteName":"Patrick_Basic, Raz_Talking","spritePosition":"Left, Right","dialog":"내담자분이 견디시기엔 감정이 너무 큰가 봐요… {wc}아, 제가 마침 보관함의 물품을 옮기던 중인데... 잠시만요!","desc":null},{"id":"Dialogue.Lulian.0010","character":"Player","spriteName":null,"spritePosition":null,"dialog":"(연구원님은 물품을 잠시 뒤적이더니 회사 마스코트 모양의 인형을 꺼냈다.)","desc":null},{"id":"Dialogue.Lulian.0011","character":"Raz","spriteName":"Patrick_Basic, Raz_Smile","spritePosition":"Left, Right","dialog":"어린 내담자분이 좋아하실만한 게 하나 있네요! 이걸 드려보는 건 어떨까요?","desc":null},{"id":"Dialogue.Lulian.0012","character":"Patrick","spriteName":"Patrick_Talking, Raz_Basic","spritePosition":"Left, Right","dialog":"...내담자 분께서 좋아할지 모르겠지만 없는 것보단 나을 겁니다. 이것도 함께 가져가 보시죠.","desc":null},{"id":"Dialogue.Lulian.0013","character":"Player","spriteName":"Patrick_Basic, Raz_Basic","spritePosition":"Left, Right","dialog":"(주머니에서 사탕을 꺼내 주셨다.) {wc}(마스코트 인형과 레몬 사탕을 얻었다.)","desc":null},{"id":"Dialogue.Lulian.0014","character":"Player","spriteName":null,"spritePosition":null,"dialog":"감사합니다!","desc":"이후 선택지 [패트릭과 대화] [라즈와 대화]"},{"id":"Dialogue.Lulian.0015","character":"Player","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"(일에 몰두하신 것 같다.)","desc":"[패트릭과 대화] 선택시"},{"id":"Dialogue.Lulian.0016","character":"Player","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"‘...사탕 좋아하실까?’","desc":null},{"id":"Dialogue.Lulian.0017","character":"Player","spriteName":"Raz_Basic","spritePosition":"Center","dialog":"(일에 몰두하신 것 같다.)","desc":"[라즈와 대화] 선택시"},{"id":"Dialogue.Lulian.0018","character":"Player","spriteName":"Raz_Basic","spritePosition":"Center","dialog":"‘...인형 좋아하실까?‘","desc":null},{"id":"Dialogue.Lulian.0019","character":"Player","spriteName":"Lulian_Stare","spritePosition":"Center","dialog":"안녕하세요, 혹시 사탕 좋아하시나요? {wc}(사탕을 내밀며 최대한 무해하다고 생각하는 표정을 지었다.)","desc":"배경\/상담실 "},{"id":"Dialogue.Lulian.0020","character":"Lulian","spriteName":"Lulian_Basic","spritePosition":"Center","dialog":"…","desc":null},{"id":"Dialogue.Lulian.0021","character":"Player","spriteName":"Lulian_Sad1","spritePosition":"Center","dialog":"(사탕을 받아 들고 참아보려고는 하지만 여전히 주체가 안 되는 것 같다.)","desc":null},{"id":"Dialogue.Lulian.0022","character":"Player","spriteName":null,"spritePosition":null,"dialog":"이제 상담 시간인데 진행해도 괜찮을까요?","desc":null},{"id":"Dialogue.Lulian.0023","character":"Lulian","spriteName":"Lulian_Sad2","spritePosition":"Center","dialog":"흡... 네에…","desc":null},{"id":"Dialogue.Lulian.0024","character":"Player","spriteName":null,"spritePosition":null,"dialog":"좀 진정이 되셨나요?","desc":null},{"id":"Dialogue.Lulian.0025","character":"Lulian","spriteName":null,"spritePosition":null,"dialog":"네... 흑... 흡…","desc":null},{"id":"Dialogue.Lulian.0026","character":"Player","spriteName":null,"spritePosition":null,"dialog":"왜 그렇게 우는지 털어놓고 나면 좀 후련해질 거예요. ","desc":null},{"id":"Dialogue.Lulian.0027","character":"Player","spriteName":null,"spritePosition":null,"dialog":"(너무 울어 진행이 되지않는다. 상담실에 있던 휴지를 앞에 내어주었다.) ","desc":null},{"id":"Dialogue.Lulian.0028","character":"Lulian","spriteName":"Lulian_Sad1","spritePosition":"Center","dialog":"…","desc":"점점 울음이 차오르며 형광 색상으로 바뀌는 일러스트"},{"id":"Dialogue.Lulian.0029","character":"Player","spriteName":null,"spritePosition":null,"dialog":"... 어...?","desc":null},{"id":"Dialogue.Lulian.0030","character":"Lulian","spriteName":"Lulian_Crying","spritePosition":"Center","dialog":"잃어버렸.... 어요.","desc":null},{"id":"Dialogue.Lulian.0031","character":"Player","spriteName":null,"spritePosition":null,"dialog":"잃어버리다니, 어떤 걸 말씀하시는 건지… {wc}‘대화가 진행되지 않을 것 같다. 감정이 고조되고 있어... 시간 내에 제련해야 해.’","desc":"퍼즐이지"},{"id":"Dialogue.Lulian.0032","character":"Player","spriteName":"Lulian_Sad1","spritePosition":"Center","dialog":"음.... 아! 이거 드릴 테니 진정하세요.... 귀엽죠? 인형이에요.","desc":null},{"id":"Dialogue.Lulian.0033","character":"Lulian","spriteName":"Lulian_Talking","spritePosition":"Center","dialog":"(인형을 꺼내 들자 반응하는 것 같더니 받아 들자 이내 실망한 표정을 짓는다.)","desc":null},{"id":"Dialogue.Lulian.0034","character":"Lulian","spriteName":"Lulian_Stare","spritePosition":"Center","dialog":"인형과 관련이 있는 건가?’","desc":null},{"id":"Dialogue.Lulian.0035","character":"Lulian","spriteName":"Lulian_Talking","spritePosition":"Center","dialog":"혹시… 제 동생은 못 보셨나요?","desc":null},{"id":"Dialogue.Lulian.0036","character":"Player","spriteName":null,"spritePosition":null,"dialog":"동생...?","desc":null},{"id":"Dialogue.Lulian.0037","character":"Lulian","spriteName":"Lulian_Sad2","spritePosition":"Center","dialog":"네... 엄마가 같이 기다리랬는데 오면서 잃어버렸어요...","desc":null},{"id":"Dialogue.Lulian.0038","character":"Player","spriteName":null,"spritePosition":null,"dialog":"’이런, 감정이 더 빠른 속도로 고조되고 있어! 좀 더 빨리 더 많이 제련해야 해.’","desc":"퍼즐노말"},{"id":"Dialogue.Lulian.0039","character":"Player","spriteName":"Lulian_Sad1","spritePosition":"Center","dialog":"그럼, 오늘 오실 때 같이 오신 거죠?","desc":null},{"id":"Dialogue.Lulian.0040","character":"Lulian","spriteName":"Lulian_Talking","spritePosition":"Center","dialog":"네.... 대기실에 놓고, 화장실 다녀온 사이에 사라졌어요… {wc}보육원에서 올 때는 분명히 같이 왔어요!","desc":null},{"id":"Dialogue.Lulian.0041","character":"Player","spriteName":"Lulian_Basic","spritePosition":"Center","dialog":"그렇군요... {wc}’쉘터 밖이 아니니 그럼 찾아볼 수 있다.’ {wc}그럼, 잠시 우유 한잔하시며 기다려 주시겠어요? 정말 금방 오겠습니다.","desc":null},{"id":"Dialogue.Lulian.0042","character":"Lulian","spriteName":"Lulian_Talking","spritePosition":"Center","dialog":"네… ","desc":null},{"id":"Dialogue.Lulian.0043","character":"Lulian","spriteName":"Lulian_Basic","spritePosition":"Center","dialog":"…","desc":null},{"id":"Dialogue.Lulian.0044","character":"Lulian","spriteName":"Lulian_Stare","spritePosition":"Center","dialog":"…","desc":null},{"id":"Dialogue.Lulian.0045","character":"Lulian","spriteName":"Lulian_Sad1","spritePosition":"Center","dialog":"…","desc":null},{"id":"Dialogue.Lulian.0046","character":"Lulian","spriteName":"Lulian_Sad2","spritePosition":"Center","dialog":"…","desc":null},{"id":"Dialogue.Lulian.0047","character":"Player","spriteName":null,"spritePosition":null,"dialog":"헉...... 허억… 헉… 혹시... 하... 잠깐 숨좀......","desc":null},{"id":"Dialogue.Lulian.0048","character":"Player","spriteName":"Lulian_Basic","spritePosition":"Center","dialog":"혹시... 하... 잠깐 숨좀...... {wc}...이걸까요?","desc":null},{"id":"Dialogue.Lulian.0049","character":"Lulian","spriteName":"Lulian_Sad2","spritePosition":"Center","dialog":"!!!","desc":null},{"id":"Dialogue.Lulian.0050","character":"Lulian","spriteName":"Lulian_Crying","spritePosition":"Center","dialog":"말랑아!!!","desc":null},{"id":"Dialogue.Lulian.0051","character":"Player","spriteName":null,"spritePosition":null,"dialog":"‘분실물 보관실에 보관되어 있었다... 어린아이니 거기까지 생각 못 했겠지.’","desc":null},{"id":"Dialogue.Lulian.0052","character":"Lulian","spriteName":null,"spritePosition":null,"dialog":"으흑... 흑... 두 번 다시... 못 찾는 줄 알고...감사... 합…","desc":null},{"id":"Dialogue.Lulian.0053","character":"Player","spriteName":null,"spritePosition":null,"dialog":"(웃으며 계속 눈물을 닦고는 있지만 결국 울음을 터뜨린다.) {wc}(자리를 비운 사이 감정이 고조 된 모양이다. 어서 제련하자.)","desc":"퍼즐하드"},{"id":"Dialogue.Lulian.0054","character":"Player","spriteName":null,"spritePosition":null,"dialog":"(내담자분께서 감정제련이 종료되자 이내 진정된 듯 밝게 웃기 시작했다.)","desc":null},{"id":"Dialogue.Lulian.0055","character":"Lulian","spriteName":"Lulian_Smile","spritePosition":"Center","dialog":"말랑이는 엄마가 만들어 주신 거예요. 제 동생이니까 잘 가지고 있으면.... 데리러 오시겠다고…","desc":null},{"id":"Dialogue.Lulian.0056","character":"Player","spriteName":null,"spritePosition":null,"dialog":"그렇군요.... 이름이 말랑이인가요?","desc":null},{"id":"Dialogue.Lulian.0057","character":"Lulian","spriteName":null,"spritePosition":null,"dialog":"네! 귀엽죠! 상담사 선생님이 찾아주셔서 이제 괜찮아요..","desc":null},{"id":"Dialogue.Lulian.0058","character":"Player","spriteName":null,"spritePosition":null,"dialog":"정말 다행이네요... 오늘 상담은 여기까지 하겠습니다.","desc":null},{"id":"Dialogue.Lulian.0059","character":"Lulian","spriteName":null,"spritePosition":null,"dialog":"네! 감사합니다!","desc":"이후 배경\/상담실 복도, 선택지 [루리안과 대화] \/ [패트릭과 대화] \/ [라즈와 대화]"},{"id":"Dialogue.Lulian.0060","character":"Player","spriteName":"Lulian_Basic","spritePosition":"Center","dialog":"이제 쉘터로 돌아가시나요?","desc":"[루리안과 대화] 선택시, 배경 상담실 복도"},{"id":"Dialogue.Lulian.0061","character":"Lulian","spriteName":"Lulian_Smile","spritePosition":"Center","dialog":"선생님! 네! 이제 말랑이랑 같이 집에 가요.","desc":"(말랑이를 끌어안은 루리안 일러스트 필요)"},{"id":"Dialogue.Lulian.0062","character":"Player","spriteName":null,"spritePosition":null,"dialog":"이제 잃어버리지 않도록 꼭 잡고 가시는 거예요.","desc":null},{"id":"Dialogue.Lulian.0063","character":"Lulian","spriteName":"Lulian_Smile","spritePosition":"Center","dialog":"네! 고마워요, 선생님! 말랑이도 인사해야지!","desc":null},{"id":"Dialogue.Lulian.0064","character":null,"spriteName":null,"spritePosition":null,"dialog":"다음에 말랑이랑 또 와요.","desc":null},{"id":"Dialogue.Lulian.0065","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"상담은 잘 마무리 하셨습니까?","desc":"[패트릭과 대화] 선택시, 배경 패트릭 연구실"},{"id":"Dialogue.Lulian.0066","character":"Player","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"네, 덕분에 잘 끝났습니다.","desc":null},{"id":"Dialogue.Lulian.0067","character":"Patrick","spriteName":"Patrick_Talking","spritePosition":"Center","dialog":"앞으론 혼자서도 잘하셔야 할 겁니다. {wc}설문조사 마무리하고 퇴근하시면 됩니다.","desc":"이후 설문조사"},{"id":"Dialogue.Lulian.0068","character":"Player","spriteName":"Patrick_Basic","spritePosition":"Center","dialog":"넵, 알겠습니다.","desc":null},{"id":"Dialogue.Lulian.0069","character":"Raz","spriteName":"Raz_Talking","spritePosition":"Center","dialog":"아까 걱정하시던 내담자분과의 상담은 무사히 잘 끝나셨나요?","desc":"[라즈와 대화] 선택시, 배경 패트릭 연구실"},{"id":"Dialogue.Lulian.0070","character":"Player","spriteName":"Raz_Basic","spritePosition":"Center","dialog":"네, 연구원님 덕이에요!","desc":null},{"id":"Dialogue.Lulian.0071","character":"Raz","spriteName":"Raz_Talking","spritePosition":"Center","dialog":"도움이 되었다니 정말 다행이에요! 내담자분과 있었던 일에 대해 얘기해주세요.","desc":"(눈 반짝 차트 적는 라즈 필요)"},{"id":"Dialogue.Lulian.0072","character":"Player","spriteName":"Raz_Basic","spritePosition":"Center","dialog":"(상담 중에 있었던 일들을 보고했다.)","desc":null},{"id":"Dialogue.Lulian.0073","character":"Raz","spriteName":"Raz_Talking","spritePosition":"Center","dialog":"동생이 인형이었군요!","desc":null},{"id":"Dialogue.Lulian.0074","character":"Player","spriteName":"Raz_Basic","spritePosition":"Center","dialog":"네, 진짜 사람인 줄 알고 철렁했어요.","desc":null},{"id":"Dialogue.Lulian.0075","character":"Raz","spriteName":"Raz_Talking","spritePosition":"Center","dialog":"그러게요, 인형이라 다행이었네요.","desc":null},{"id":"Dialogue.Lulian.0076","character":"Player","spriteName":"Raz_Basic","spritePosition":"Center","dialog":"연구원님도 좋아하시나요?","desc":null},{"id":"Dialogue.Lulian.0077","character":"Raz","spriteName":"Raz_Talking","spritePosition":"Center","dialog":"어떤걸요?","desc":null},{"id":"Dialogue.Lulian.0078","character":"Player","spriteName":null,"spritePosition":null,"dialog":"인형이요.","desc":null},{"id":"Dialogue.Lulian.0079","character":"Raz","spriteName":"Raz_Smile","spritePosition":"Center","dialog":"아, 네! 좋아해요.","desc":"화사한 효과"},{"id":"Dialogue.Lulian.0080","character":"Player","spriteName":null,"spritePosition":null,"dialog":"‘어라?’","desc":null},{"id":"Dialogue.Lulian.0081","character":"Raz","spriteName":"Raz_Talking","spritePosition":"Center","dialog":"왜 그러세요?","desc":null},{"id":"Dialogue.Lulian.0082","character":"Player","spriteName":null,"spritePosition":null,"dialog":"아, 아무것도 아닙니다. 오늘도 고생 많으셨습니다!","desc":null},{"id":"Dialogue.Lulian.0083","character":"Raz","spriteName":null,"spritePosition":null,"dialog":"네, {$PlayerName} 선생님도 수고하셨어요!","desc":null}]